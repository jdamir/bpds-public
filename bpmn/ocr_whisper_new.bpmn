<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di_1="http://www.omg.org/spec/DD/20100524/DI" xmlns:di="http://omg.org" id="Definitions_11n5h9w" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.29.0">
  <bpmn:collaboration id="Collaboration_Media">
    <bpmn:participant id="Participant_Media" name="Автоматическое распознавание медиаданных" processRef="Process_Media" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Media" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Media">
      <bpmn:lane id="Lane_Analytics" name="АНАЛИТИКА / DWH">
        <bpmn:flowNodeRef>Task_EventLog</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Log_Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AI_Layer" name="КОНТУР ИИ (AI LAYER)">
        <bpmn:flowNodeRef>Task_OCR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Whisper</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Parser</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Orchestration" name="ОРКЕСТРАЦИЯ (GO)">
        <bpmn:flowNodeRef>Gateway_Merge_Media</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Parallel_Mining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Media_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BatchMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StreamMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Merge_Type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Media</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateDto</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_UI" name="UI ИНТЕРФЕЙС">
        <bpmn:flowNodeRef>Start_Media</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendStream</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:exclusiveGateway id="Gateway_Merge_Media" name="Слияние веток распознавания">
      <bpmn:incoming>Flow_Merge_Media1</bpmn:incoming>
      <bpmn:incoming>Flow_Merge_Media2</bpmn:incoming>
      <bpmn:outgoing>Flow_To_DTO</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_Parallel_Mining" name="Разделение для Process Mining">
      <bpmn:incoming>Flow_To_Parallel</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Log</bpmn:outgoing>
      <bpmn:outgoing>Flow_To_End</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="End_Media_Success" name="Данные распознаны">
      <bpmn:incoming>Flow_To_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_M1" sourceRef="Start_Media" targetRef="Task_SendStream" />
    <bpmn:sequenceFlow id="Flow_M2" sourceRef="Task_SendStream" targetRef="Gateway_Type" />
    <bpmn:sequenceFlow id="Flow_Type_Batch" name="Пакетный" sourceRef="Gateway_Type" targetRef="Task_BatchMethod" />
    <bpmn:sequenceFlow id="Flow_Type_Stream" name="Стриминг" sourceRef="Gateway_Type" targetRef="Task_StreamMethod" />
    <bpmn:sequenceFlow id="Flow_Merge_Type1" sourceRef="Task_BatchMethod" targetRef="Gateway_Merge_Type" />
    <bpmn:sequenceFlow id="Flow_Merge_Type2" sourceRef="Task_StreamMethod" targetRef="Gateway_Merge_Type" />
    <bpmn:sequenceFlow id="Flow_To_Media" sourceRef="Gateway_Merge_Type" targetRef="Gateway_Media" />
    <bpmn:sequenceFlow id="Flow_Media_Voice" name="Голос" sourceRef="Gateway_Media" targetRef="Task_Whisper" />
    <bpmn:sequenceFlow id="Flow_Media_Image" name="Картинка" sourceRef="Gateway_Media" targetRef="Task_OCR" />
    <bpmn:sequenceFlow id="Flow_To_Parser" sourceRef="Task_Whisper" targetRef="Task_Parser" />
    <bpmn:sequenceFlow id="Flow_Merge_Media1" sourceRef="Task_Parser" targetRef="Gateway_Merge_Media" />
    <bpmn:sequenceFlow id="Flow_Merge_Media2" sourceRef="Task_OCR" targetRef="Gateway_Merge_Media" />
    <bpmn:sequenceFlow id="Flow_To_DTO" sourceRef="Gateway_Merge_Media" targetRef="Task_CreateDto" />
    <bpmn:sequenceFlow id="Flow_To_Parallel" sourceRef="Task_CreateDto" targetRef="Gateway_Parallel_Mining" />
    <bpmn:sequenceFlow id="Flow_To_Log" name="Лог" sourceRef="Gateway_Parallel_Mining" targetRef="Task_EventLog" />
    <bpmn:sequenceFlow id="Flow_To_End" sourceRef="Gateway_Parallel_Mining" targetRef="End_Media_Success" />
    <bpmn:sequenceFlow id="Flow_Log_Done" sourceRef="Task_EventLog" targetRef="End_Log_Done" />
    <bpmn:serviceTask id="Task_BatchMethod" name="2. Пакетный метод (Файл целиком из MinIO)">
      <bpmn:incoming>Flow_Type_Batch</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_Type1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_StreamMethod" name="3. Стрим-метод (Потоковый gRPC / HTTP/2)">
      <bpmn:incoming>Flow_Type_Stream</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_Type2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Type" name="Тип?">
      <bpmn:incoming>Flow_M2</bpmn:incoming>
      <bpmn:outgoing>Flow_Type_Batch</bpmn:outgoing>
      <bpmn:outgoing>Flow_Type_Stream</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Merge_Type">
      <bpmn:incoming>Flow_Merge_Type1</bpmn:incoming>
      <bpmn:incoming>Flow_Merge_Type2</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Media</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Media" name="Медиа?">
      <bpmn:incoming>Flow_To_Media</bpmn:incoming>
      <bpmn:outgoing>Flow_Media_Voice</bpmn:outgoing>
      <bpmn:outgoing>Flow_Media_Image</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_OCR" name="4а. Движок OCR (Снимок) Выход: Сразу готовый JSON">
      <bpmn:incoming>Flow_Media_Image</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_Media2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Whisper" name="4б. Движок Whisper (Аудио) Выход: Сырая строка текста">
      <bpmn:incoming>Flow_Media_Voice</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Parser</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Parser" name="4в. Семантический парсер Превратить текст в JSON">
      <bpmn:incoming>Flow_To_Parser</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_Media1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CreateDto" name="5. Сформировать DTO и обновить холодильник">
      <bpmn:incoming>Flow_To_DTO</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Parallel</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_EventLog" name="12-13. Зафиксировать шаг в Event Log (ClickHouse)">
      <bpmn:incoming>Flow_To_Log</bpmn:incoming>
      <bpmn:outgoing>Flow_Log_Done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Log_Done" name="Событие логировано">
      <bpmn:incoming>Flow_Log_Done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_Media" name="Запрос на оцифровку">
      <bpmn:outgoing>Flow_M1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_SendStream" name="1. Отправить медиапоток (Снимок чека и/или Аудио)">
      <bpmn:incoming>Flow_M1</bpmn:incoming>
      <bpmn:outgoing>Flow_M2</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Media">
      <bpmndi:BPMNShape id="Participant_Media_di" bpmnElement="Participant_Media" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1328" height="750" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_UI_di" bpmnElement="Lane_UI" isHorizontal="true">
        <dc:Bounds x="190" y="670" width="1298" height="160" />
