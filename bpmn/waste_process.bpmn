      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Dto_Ok_di" bpmnElement="Gateway_Dto_Ok" isMarkerVisible="true">
        <dc:Bounds x="540" y="395" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="541" y="371" width="49" height="14" />
