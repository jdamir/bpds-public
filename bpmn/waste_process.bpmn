      <bpmndi:BPMNShape id="Gateway_Type_Split_di" bpmnElement="Gateway_Type_Split" isMarkerVisible="true">
        <dc:Bounds x="670" y="395" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="682" y="455" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Waste_Error_di" bpmnElement="End_Waste_Error">
        <dc:Bounds x="762" y="537" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="736" y="580" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TrashEndpoint_di" bpmnElement="Task_TrashEndpoint">
        <dc:Bounds x="510" y="240" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateStock_di" bpmnElement="Task_UpdateStock">
        <dc:Bounds x="1096" y="240" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Merge_Endpoints_di" bpmnElement="Gateway_Merge_Endpoints" isMarkerVisible="true">
        <dc:Bounds x="1005" y="255" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="986" y="305" width="88" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EventLog_di" bpmnElement="Task_EventLog">
        <dc:Bounds x="910" y="90" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Log_Done_di" bpmnElement="End_Log_Done">
        <dc:Bounds x="1302" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1210" y="106" width="60" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Parallel_Split_di" bpmnElement="Gateway_Parallel_Split">
        <dc:Bounds x="1305" y="255" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1348.5" y="206" width="61" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Waste_Success_di" bpmnElement="End_Waste_Success">
        <dc:Bounds x="1312" y="537" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1286" y="580" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConsumeEndpoint_di" bpmnElement="Task_ConsumeEndpoint">
        <dc:Bounds x="810" y="210" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_W1_di" bpmnElement="Flow_W1">
        <di_1:waypoint x="276" y="555" />
        <di_1:waypoint x="320" y="555" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W2_di" bpmnElement="Flow_W2">
        <di_1:waypoint x="400" y="515" />
        <di_1:waypoint x="400" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W3_di" bpmnElement="Flow_W3">
        <di_1:waypoint x="500" y="420" />
        <di_1:waypoint x="540" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Dto_Yes_di" bpmnElement="Flow_Dto_Yes">
        <di_1:waypoint x="590" y="420" />
        <di_1:waypoint x="670" y="420" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="623" y="402" width="14" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Dto_No_di" bpmnElement="Flow_Dto_No">
        <di_1:waypoint x="565" y="445" />
        <di_1:waypoint x="565" y="515" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="551" y="468" width="19" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Error_End_di" bpmnElement="Flow_Error_End">
        <di_1:waypoint x="690" y="555" />
        <di_1:waypoint x="762" y="555" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Type_Consume_di" bpmnElement="Flow_Type_Consume">
        <di_1:waypoint x="695" y="395" />
        <di_1:waypoint x="695" y="250" />
        <di_1:waypoint x="810" y="250" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="661" y="213" width="68" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Type_Trash_di" bpmnElement="Flow_Type_Trash">
        <di_1:waypoint x="695" y="395" />
        <di_1:waypoint x="695" y="358" />
        <di_1:waypoint x="590" y="358" />
        <di_1:waypoint x="590" y="320" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="444" y="328" width="52" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Merge_2_di" bpmnElement="Flow_Merge_2">
